*/

/* Spotlight (Paper: Lichii Launcher Redesign, 02 · Spotlight). Values match spotlight/theme.h.
   Surfaces: window #0b0c10, deep panel #0f1016, panel #12131a, card 5% white with an 8% stroke,
   control fill 8% white, outlined control 12% white with an 18% stroke, dialog #15161e.
   Radii: track 3, key cap 7, small rows 10, fields 12, rows 13, tiles 14, menus 16, cards 20,
   dialogs 22; buttons and tabs are pills (half their height): 40 px, 34 px when compact.
   Text: white, 62% secondary, 55% muted. Accent #ff6b95, on-accent #2a0a14. */

QWidget {
    color: #ffffff;
    background-color: #0b0c10;
    selection-background-color: rgba(255, 107, 149, 89);
    selection-color: #ffffff;
    border: 0;
    outline: 0;
}

QWidget:disabled {
    color: rgba(255, 255, 255, 92);
}

QToolTip {
    font-family: "Lexend";
    font-size: 13px;
    color: #ffffff;
    background-color: #181a24;
    border: 1px solid rgba(255, 255, 255, 31);
    border-radius: 10px;
    padding: 6px 10px;
}

QMainWindow::separator {
    background-color: rgba(255, 255, 255, 20);
    width: 1px;
    height: 1px;
}

QLabel {
    background-color: transparent;
}

QLabel:disabled {
    color: rgba(255, 255, 255, 92);
}

/* Menus ----------------------------------------------------------------- */

QMenuBar {
    background-color: #181a24;
    border-bottom: 1px solid rgba(255, 255, 255, 31);
    padding: 3px 13px;
    font-weight: 500;
}

QMenuBar::item {
    background: transparent;
    color: #ffffff;
    margin: 0 2px;
    padding: 5px 11px;
    border-radius: 8px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: rgba(255, 255, 255, 31);
}

QMenu {
    font-family: "Lexend";
    font-size: 14px;
    font-weight: 500;
    background-color: #181a24;
    border: 1px solid rgba(255, 255, 255, 31);
    border-radius: 16px;
    padding: 6px;
}

QMenu::item {
    background: transparent;
    color: #ffffff;
    min-height: 36px;
    padding: 0 18px 0 17px;
    border-radius: 10px;
}

QMenu::item:selected {
    background-color: rgba(255, 255, 255, 26);
    color: #ffffff;
}

QMenu::item:disabled {
    color: rgba(255, 255, 255, 92);
}

QMenu::icon {
    width: 16px;
    height: 16px;
    padding-left: 15px;
}

QMenu::separator {
    height: 1px;
    background: rgba(255, 255, 255, 26);
    margin: 4px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    padding-left: 6px;
}

QMenu::indicator:non-exclusive:checked,
QMenu::indicator:exclusive:checked {
    image: url(:/lichii/icons/check_on.png);
}

QMenu::right-arrow {
    image: url(:/lichii/icons/chevron_right.png);
    width: 12px;
    height: 12px;
    padding-right: 6px;
}

/* Buttons: pills. Secondary by default; the default button is primary. Set the "kind" property
   to "primary", "outlined", "ghost", "destructive" or "danger" (solid red) for the others. A button shows its focus ring only after
   keyboard navigation (the Spotlight style sets "keyboardFocus"). ------------------------------- */

QPushButton {
    background-color: rgba(255, 255, 255, 20);
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 20px;
    padding: 0 17px;
    min-height: 38px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 31);
}

QPushButton:pressed,
QPushButton:checked {
    background-color: rgba(255, 255, 255, 46);
}

QPushButton[kind="outlined"] {
    background-color: rgba(255, 255, 255, 31);
    border-color: rgba(255, 255, 255, 46);
}

QPushButton[kind="outlined"]:hover {
    background-color: rgba(255, 255, 255, 46);
}

QPushButton[compact="true"] {
    border-radius: 17px;
    padding: 0 13px;
    min-height: 32px;
    font-size: 13px;
}

QPushButton:default,
QPushButton[kind="primary"] {
    background-color: #ff6b95;
    border-color: #ff6b95;
    color: #2a0a14;
    font-weight: 600;
}

QPushButton:default:hover,
QPushButton:default:pressed,
QPushButton[kind="primary"]:hover,
QPushButton[kind="primary"]:pressed {
    background-color: #ff8fae;
    border-color: #ff8fae;
}

QPushButton[kind="ghost"] {
    background-color: transparent;
    border-color: transparent;
    color: rgba(255, 255, 255, 200);
}

QPushButton[kind="ghost"]:hover {
    background-color: rgba(255, 255, 255, 20);
    color: #ffffff;
}

QPushButton[kind="ghost"]:pressed {
    background-color: rgba(255, 255, 255, 36);
}

QPushButton[kind="destructive"] {
    background-color: rgba(255, 143, 174, 31);
    border-color: transparent;
    color: #ff8fae;
}

QPushButton[kind="destructive"]:hover,
QPushButton[kind="destructive"]:pressed {
    background-color: rgba(255, 143, 174, 56);
}

QPushButton[kind="danger"] {
    background-color: #ff5c7a;
    border-color: #ff5c7a;
    color: #2a0a14;
}

QPushButton[kind="danger"]:hover,
QPushButton[kind="danger"]:pressed {
    background-color: #ff7d95;
    border-color: #ff7d95;
}

QPushButton[kind="outlined"]:default {
    background-color: rgba(255, 255, 255, 31);
    border-color: rgba(255, 255, 255, 46);
    color: #ffffff;
}

QPushButton[kind="outlined"]:default:hover,
QPushButton[kind="outlined"]:default:pressed {
    background-color: rgba(255, 255, 255, 46);
}

QPushButton[keyboardFocus="true"] {
    border-color: #ffffff;
}

QPushButton:disabled,
QPushButton:default:disabled,
QPushButton[kind="primary"]:disabled,
QPushButton[kind="destructive"]:disabled,
QPushButton[kind="danger"]:disabled,
QPushButton[kind="outlined"]:disabled,
QPushButton[kind="outlined"]:default:disabled {
    background-color: rgba(255, 255, 255, 15);
    border-color: transparent;
    color: rgba(255, 255, 255, 89);
}

QPushButton[kind="ghost"]:disabled {
    background-color: transparent;
    border-color: transparent;
}

QPushButton:flat {
    background-color: transparent;
    border-color: transparent;
}

QPushButton:flat:hover {
    background-color: rgba(255, 255, 255, 20);
}

QPushButton::menu-indicator {
    image: url(:/lichii/icons/chevron_down.png);
    subcontrol-position: right center;
    subcontrol-origin: padding;
    right: 6px;
    width: 12px;
    height: 12px;
}

QToolButton {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 4px;
}

QToolButton:hover {
    background-color: rgba(255, 255, 255, 20);
}

QToolButton:pressed,
QToolButton:checked {
    background-color: rgba(255, 255, 255, 46);
}

QToolButton[keyboardFocus="true"] {
    border-color: #ffffff;
}

QToolButton::menu-button {
    border: 0;
    width: 16px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

QToolButton::menu-arrow {
    image: url(:/lichii/icons/chevron_down.png);
    width: 10px;
    height: 10px;
}

QDialogButtonBox {
    background-color: transparent;
    dialogbuttonbox-buttons-have-icons: 0;
}

QMessageBox {
    messagebox-information-icon: url(:/lichii/icons/msgbox_information.png);
    messagebox-question-icon: url(:/lichii/icons/msgbox_question.png);
    messagebox-warning-icon: url(:/lichii/icons/msgbox_warning.png);
    messagebox-critical-icon: url(:/lichii/icons/msgbox_critical.png);
}

/* Dialog chrome: Spotlight::Dialog and every message box, input and progress dialog sit in a
   painted card, so the window and its plain containers stay transparent. */
QDialog[spotlightChrome="true"],
QDialog[spotlightChrome="true"] .QWidget,
QDialog[spotlightChrome="true"] .QFrame,
QDialog[spotlightChrome="true"] QStackedWidget,
QDialog[spotlightChrome="true"] QScrollArea,
QDialog[spotlightChrome="true"] QScrollArea > QWidget > QWidget {
    background: transparent;
}

QMessageBox QLabel#qt_msgbox_label,
QMessageBox QLabel#qt_msgbox_informativelabel {
    font-size: 14px;
}

QMessageBox QDialogButtonBox QPushButton {
    border-radius: 18px;
    min-height: 34px;
    min-width: 0;
    font-size: 13px;
}

QMessageBox QLabel#qt_msgbox_label {
    color: rgba(255, 255, 255, 158);
}

QMessageBox QLabel#qt_msgbox_informativelabel {
    color: rgba(255, 255, 255, 158);
}

QMessageBox QLabel#qt_msgboxex_icon_label {
    padding-right: 6px;
}

QInputDialog QLabel {
    color: rgba(255, 255, 255, 158);
}

/* Inputs: single-line fields are pills, multi-line fields rounded rectangles ------------------ */

QLineEdit,
QAbstractSpinBox,
QDateTimeEdit {
    background-color: rgba(255, 255, 255, 15);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 31);
    border-radius: 12px;
    min-height: 38px;
    padding: 0 13px;
    font-size: 14px;
    selection-background-color: rgba(255, 107, 149, 115);
}

QComboBox {
    background-color: rgba(255, 255, 255, 20);
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 12px;
    min-height: 32px;
    padding: 0 30px 0 13px;
    font-size: 13px;
    font-weight: 600;
    selection-background-color: rgba(255, 107, 149, 115);
}

QPlainTextEdit,
QTextEdit {
    background-color: rgba(255, 255, 255, 15);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 31);
    border-radius: 12px;
    padding: 4px 6px;
    selection-background-color: rgba(255, 107, 149, 115);
}

QLineEdit:hover,
QAbstractSpinBox:hover,
QPlainTextEdit:hover,
QTextEdit:hover {
    border-color: rgba(255, 255, 255, 56);
}

QComboBox:hover {
    background-color: rgba(255, 255, 255, 31);
}

QLineEdit:focus,
QAbstractSpinBox:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QComboBox:on {
    border-color: #ff6b95;
}

QComboBox:focus {
    border-color: rgba(255, 107, 149, 179);
}

QLineEdit:disabled,
QAbstractSpinBox:disabled,
QComboBox:disabled,
QDateTimeEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled {
    background-color: rgba(255, 255, 255, 8);
    border-color: rgba(255, 255, 255, 20);
    color: rgba(255, 255, 255, 92);
}

QLineEdit:read-only,
QPlainTextEdit:read-only,
QTextEdit:read-only {
    background-color: rgba(255, 255, 255, 8);
}

QLineEdit[frame="false"],
QAbstractSpinBox[frame="false"] {
    background-color: transparent;
    border-color: transparent;
    border-radius: 0;
    min-height: 0;
    padding: 0;
}

QComboBox:editable {
    background-color: rgba(255, 255, 255, 15);
    border-color: rgba(255, 255, 255, 31);
    font-size: 14px;
    font-weight: 500;
}

QComboBox QLineEdit,
QComboBox QLineEdit:focus,
QComboBox QLineEdit:hover,
QAbstractSpinBox QLineEdit {
    background: transparent;
    border: 0;
    border-radius: 0;
    min-height: 0;
    padding: 0;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 28px;
    border: 0;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(:/lichii/icons/chevron_down.png);
    width: 12px;
    height: 12px;
}

QComboBox::down-arrow:disabled {
    image: url(:/lichii/icons/chevron_down_disabled.png);
}

QComboBoxPrivateContainer {
    background: transparent;
    border: 0;
}

QComboBox QAbstractItemView {
    background-color: #181a24;
    border: 1px solid rgba(255, 255, 255, 31);
    border-radius: 14px;
    padding: 5px;
    outline: 0;
    selection-background-color: rgba(255, 255, 255, 26);
    selection-color: #ffffff;
}

QComboBox QAbstractItemView::item {
    min-height: 32px;
    padding: 0 10px;
    border-radius: 10px;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: rgba(255, 255, 255, 26);
    color: #ffffff;
}

QComboBox[global="true"] {
    color: rgba(255, 255, 255, 140);
}

QAbstractSpinBox {
    padding-right: 28px;
}

QAbstractSpinBox[buttonSymbols="NoButtons"] {
    padding-right: 13px;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 24px;
    border: 0;
    background: transparent;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    margin: 4px 6px 0 0;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    margin: 0 6px 4px 0;
}

QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    background-color: rgba(255, 255, 255, 20);
    border-radius: 6px;
}

QAbstractSpinBox::up-arrow {
    image: url(:/lichii/icons/chevron_up.png);
    width: 10px;
    height: 10px;
}

QAbstractSpinBox::down-arrow {
    image: url(:/lichii/icons/chevron_down.png);
    width: 10px;
    height: 10px;
}

QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off {
    image: url(:/lichii/icons/chevron_up_disabled.png);
}

QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off {
    image: url(:/lichii/icons/chevron_down_disabled.png);
}

QCalendarWidget QWidget {
    alternate-background-color: #12131a;
}

QCalendarWidget QToolButton {
    border-radius: 12px;
    padding: 4px 8px;
}

/* Check boxes, toggles, radios ------------------------------------------ */

QCheckBox,
QRadioButton {
    background-color: transparent;
    spacing: 10px;
    min-height: 24px;
}

QCheckBox::indicator,
QGroupBox::indicator,
QTreeView::indicator,
QListView::indicator,
QTableView::indicator {
    width: 20px;
    height: 20px;
}

QCheckBox::indicator:unchecked,
QGroupBox::indicator:unchecked,
QAbstractItemView::indicator:unchecked {
    image: url(:/lichii/icons/check_off.png);
}

QCheckBox::indicator:unchecked:hover,
QGroupBox::indicator:unchecked:hover {
    image: url(:/lichii/icons/check_off_hover.png);
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QAbstractItemView::indicator:checked {
    image: url(:/lichii/icons/check_on.png);
}

QCheckBox::indicator:indeterminate,
QAbstractItemView::indicator:indeterminate {
    image: url(:/lichii/icons/check_mixed.png);
}

QCheckBox::indicator:unchecked:disabled,
QGroupBox::indicator:unchecked:disabled {
    image: url(:/lichii/icons/check_off_disabled.png);
}

QCheckBox::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled {
    image: url(:/lichii/icons/check_on_disabled.png);
}

/* A setting that switches a feature on or off. ConfigurationShared::UseToggles marks them. */
QCheckBox[toggle="true"]::indicator {
    width: 44px;
    height: 26px;
}

QCheckBox[toggle="true"]::indicator:unchecked {
    image: url(:/lichii/icons/toggle_off.png);
}

QCheckBox[toggle="true"]::indicator:unchecked:hover {
    image: url(:/lichii/icons/toggle_off_hover.png);
}

QCheckBox[toggle="true"]::indicator:checked {
    image: url(:/lichii/icons/toggle_on.png);
}

QCheckBox[toggle="true"]::indicator:unchecked:disabled {
    image: url(:/lichii/icons/toggle_off_disabled.png);
}

QCheckBox[toggle="true"]::indicator:checked:disabled {
    image: url(:/lichii/icons/toggle_on_disabled.png);
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
}

QRadioButton::indicator:unchecked {
    image: url(:/lichii/icons/radio_off.png);
}

QRadioButton::indicator:unchecked:hover {
    image: url(:/lichii/icons/radio_off_hover.png);
}

QRadioButton::indicator:checked {
    image: url(:/lichii/icons/radio_on.png);
}

QRadioButton::indicator:unchecked:disabled {
    image: url(:/lichii/icons/radio_off_disabled.png);
}

QRadioButton::indicator:checked:disabled {
    image: url(:/lichii/icons/radio_on_disabled.png);
}

/* Per-game settings: a value changed for this game, and its reset button. */
ConfigurationShared--Widget[custom="true"] QLabel,
ConfigurationShared--Widget[custom="true"] QCheckBox {
    color: #ffffff;
    font-weight: 600;
}

ConfigurationShared--Widget[custom="true"] QComboBox,
ConfigurationShared--Widget[custom="true"] QLineEdit,
ConfigurationShared--Widget[custom="true"] QAbstractSpinBox {
    border-color: rgba(255, 107, 149, 140);
}

QPushButton[restore="true"] {
    background-color: rgba(255, 107, 149, 36);
    border: 0;
    border-radius: 10px;
    padding: 0;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
}

QPushButton[restore="true"]:hover {
    background-color: rgba(255, 107, 149, 36);
}

/* Sliders and progress -------------------------------------------------- */

QSlider {
    background-color: transparent;
}

QSlider::groove:horizontal {
    height: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 46);
}

QSlider::sub-page:horizontal {
    height: 6px;
    border-radius: 3px;
    background-color: #ff6b95;
}

QSlider::sub-page:horizontal:disabled {
    background-color: rgba(255, 107, 149, 89);
}

QSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
    background-color: #ffffff;
}

QSlider::handle:horizontal:disabled {
    background-color: #6b6d73;
}

QSlider::groove:vertical {
    width: 4px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 46);
}

QSlider::add-page:vertical {
    width: 4px;
    border-radius: 2px;
    background-color: #ff6b95;
}

QSlider::handle:vertical {
    width: 16px;
    height: 16px;
    margin: 0 -6px;
    border-radius: 8px;
    background-color: #ffffff;
}

QProgressBar {
    background-color: rgba(255, 255, 255, 20);
    border: 0;
    border-radius: 9px;
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    text-align: center;
    min-height: 18px;
    max-height: 18px;
}

QProgressBar::chunk {
    background-color: #ff6b95;
    border-radius: 9px;
}

QProgressBar[textVisible="false"] {
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
}

QProgressBar[textVisible="false"]::chunk {
    border-radius: 3px;
}

QProgressDialog QProgressBar[textVisible="false"],
Spotlight--Dialog QProgressBar[textVisible="false"] {
    background-color: rgba(255, 255, 255, 46);
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}

QProgressDialog QProgressBar[textVisible="false"]::chunk,
Spotlight--Dialog QProgressBar[textVisible="false"]::chunk {
    border-radius: 4px;
}

/* Scroll bars: thin rounded handles on a clear track ------------------------------------------ */

QScrollArea,
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QAbstractScrollArea::corner {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 3px 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px 3px;
}

QScrollBar::handle:vertical {
    background-color: rgba(255, 255, 255, 46);
    min-height: 32px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(255, 255, 255, 46);
    min-width: 32px;
    border-radius: 3px;
}

QScrollBar::handle:hover,
QScrollBar::handle:pressed {
    background-color: rgba(255, 255, 255, 107);
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    width: 0;
    height: 0;
    border: 0;
}

/* Tabs: pills in a rounded track, the current one pink (Paper's segmented control) ------------ */

QTabWidget::pane {
    border: 0;
    background-color: transparent;
    top: 6px;
}

QTabBar {
    background-color: rgba(255, 255, 255, 15);
    border-radius: 19px;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background: transparent;
    color: rgba(255, 255, 255, 179);
    border: 0;
    border-radius: 16px;
    min-height: 32px;
    padding: 0 14px;
    margin: 3px 1px;
    font-weight: 500;
}

QTabBar::tab:first {
    margin-left: 3px;
}

QTabBar::tab:last {
    margin-right: 3px;
}

QTabBar::tab:only-one {
    margin-left: 3px;
    margin-right: 3px;
}

QTabBar::tab:hover {
    background-color: rgba(255, 255, 255, 20);
    color: #ffffff;
}

QTabBar::tab:selected {
    background-color: #ff6b95;
    color: #2a0a14;
    font-weight: 600;
}

QTabBar::tab:disabled {
    color: rgba(255, 255, 255, 92);
}

QTabBar::tab:left,
QTabBar::tab:right {
    min-height: 0;
    min-width: 32px;
    padding: 12px 0;
    margin: 1px 3px;
}

QTabBar QToolButton {
    background-color: #181a24;
    border: 1px solid rgba(255, 255, 255, 31);
    border-radius: 13px;
    width: 24px;
    margin: 6px 1px;
}

QTabBar QToolButton:disabled {
    background-color: #12131a;
}

QTabBar::scroller {
    width: 56px;
}

QTabBar QToolButton::left-arrow {
    image: url(:/lichii/icons/chevron_left.png);
}

QTabBar QToolButton::left-arrow:disabled {
    image: url(:/lichii/icons/chevron_left_disabled.png);
}

QTabBar QToolButton::right-arrow {
    image: url(:/lichii/icons/chevron_right.png);
}

QTabBar QToolButton::right-arrow:disabled {
    image: url(:/lichii/icons/chevron_right_disabled.png);
}

/* Group boxes: Paper's settings cards, the title above the card -------------------------------- */

QGroupBox {
    background-color: rgba(255, 255, 255, 13);
    border: 1px solid rgba(255, 255, 255, 20);
    border-radius: 20px;
    margin-top: 28px;
    padding: 8px 6px 6px 6px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    top: 4px;
    color: rgba(255, 255, 255, 158);
    background-color: transparent;
}

QGroupBox::indicator {
    margin-right: 6px;
}

QGroupBox:flat,
QGroupBox QGroupBox {
    background-color: transparent;
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 18);
    border-radius: 0;
    padding: 6px 0 0 0;
}

QGroupBox QGroupBox::title {
    left: 0;
}

/* Item views: a rounded frame, rounded hover and selection ------------------------------------ */

QAbstractItemView {
    background-color: rgba(255, 255, 255, 8);
    alternate-background-color: rgba(255, 255, 255, 5);
    border: 1px solid rgba(255, 255, 255, 20);
    border-radius: 14px;
    padding: 4px;
    selection-background-color: rgba(255, 107, 149, 36);
    selection-color: #ffffff;
    show-decoration-selected: 1;
}

QAbstractItemView:focus {
    border-color: rgba(255, 255, 255, 36);
}

QAbstractItemView::item {
    border: 0;
    min-height: 24px;
}

QTreeView,
QTableView {
    selection-background-color: transparent;
}

QAbstractItemView::item:hover {
    background-color: rgba(255, 255, 255, 20);
}

QAbstractItemView::item:selected,
QAbstractItemView::item:selected:active,
QAbstractItemView::item:selected:!active {
    background-color: rgba(255, 107, 149, 36);
    color: #ffffff;
}

QListView::item {
    border-radius: 10px;
    padding: 0 6px;
}

QTreeView::item:first,
QTableView::item:first {
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
}

QTreeView::item:last,
QTableView::item:last {
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

QTreeView::item:only-one,
QTableView::item:only-one {
    border-radius: 10px;
}

QWidget#spotlightLauncher,
QWidget#spotlightTopBar,
QWidget#spotlightHero,
QWidget#spotlightLibraryHeader,
QWidget#spotlightGameList,
QWidget#spotlightGameListPlaceholder,
QListView#spotlightGrid,
QListView#spotlightCarousel,
QTreeView#spotlightTree {
    background-color: transparent;
}

QListView#spotlightGrid,
QListView#spotlightCarousel,
QTreeView#spotlightTree {
    border: 0;
    border-radius: 0;
    padding: 0;
}

QTreeView#spotlightTree {
    background-color: rgba(255, 255, 255, 13);
    border: 1px solid rgba(255, 255, 255, 20);
    border-radius: 18px;
    padding: 8px;
}

QTreeView#spotlightTree QHeaderView,
QTreeView#spotlightTree QHeaderView::section {
    background-color: transparent;
    font-size: 12px;
    font-weight: 600;
}

QTreeView#spotlightTree::branch:selected,
QTreeView#spotlightTree::item,
QTreeView#spotlightTree::item:hover,
QTreeView#spotlightTree::item:selected {
    background-color: transparent;
}

QTreeView#spotlightTree {
    selection-background-color: transparent;
}

QTreeView {
    show-decoration-selected: 0;
}

QTreeView::branch {
    background: transparent;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/lichii/icons/chevron_right.png);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/lichii/icons/chevron_down.png);
}

QHeaderView {
    background-color: transparent;
    border: 0;
}

QHeaderView::section {
    background-color: transparent;
    color: rgba(255, 255, 255, 140);
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 18);
    padding: 0 10px;
    min-height: 30px;
    font-weight: 600;
}

QHeaderView::section:vertical {
    border-bottom: 0;
    border-right: 1px solid rgba(255, 255, 255, 18);
}

QHeaderView::section:hover {
    color: #ffffff;
}

QHeaderView::down-arrow {
    image: url(:/lichii/icons/chevron_down.png);
    width: 10px;
    height: 10px;
}

QHeaderView::up-arrow {
    image: url(:/lichii/icons/chevron_up.png);
    width: 10px;
    height: 10px;
}

QTableView {
    gridline-color: rgba(255, 255, 255, 18);
}

QTableCornerButton::section {
    background-color: transparent;
    border: 0;
}

/* Configure: category list on the left */
QListWidget#selectorList {
    background-color: #0f1016;
    border: 0;
    border-right: 1px solid rgba(255, 255, 255, 20);
    border-radius: 0;
    padding: 12px 8px;
    outline: 0;
}

QListWidget#selectorList::item {
    color: rgba(255, 255, 255, 158);
    min-height: 34px;
    padding: 0 10px;
    border-radius: 10px;
    margin-bottom: 2px;
}

QListWidget#selectorList::item:hover {
    background-color: rgba(255, 255, 255, 20);
}

QListWidget#selectorList::item:selected {
    background-color: rgba(255, 107, 149, 41);
    color: #ffffff;
    font-weight: 600;
}

/* Per-game Properties: the game's info column */
QDialog#ConfigurePerGame QGroupBox#gameInfo {
    background-color: #0f1016;
    border: 0;
    border-right: 1px solid rgba(255, 255, 255, 20);
    margin-top: 0;
    padding: 16px 12px;
}

QDialog#ConfigurePerGame QGroupBox#gameInfo::title {
    color: transparent;
}

QDialog#ConfigurePerGame QGroupBox#gameInfo QLineEdit {
    background-color: transparent;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 20);
    border-radius: 0;
    padding: 0 2px;
    color: #ffffff;
}

QDialog#ConfigurePerGame QGraphicsView {
    border-radius: 13px;
    background-color: #12131a;
}

QDialog#ConfigureDialog QLabel#label,
QDialog#ConfigurePerGame QLabel#label_8 {
    color: rgba(255, 255, 255, 115);
}

/* About ---------------------------------------------------------------- */

QDialog#AboutDialog {
    background: transparent;
}

QDialog#AboutDialog QLabel#labelAbout {
    color: rgba(255, 255, 255, 158);
}

QDialog#AboutDialog QWidget#aboutRule {
    background-color: rgba(255, 255, 255, 20);
}

QDialog#AboutDialog QLabel#labelBuildInfo,
QDialog#AboutDialog QLabel#labelLiability {
    color: rgba(255, 255, 255, 140);
}

/* Status bar: setting chips on the left, stats on the right ------------- */

QStatusBar {
    background-color: #12131a;
    border-top: 1px solid rgba(255, 255, 255, 20);
    color: rgba(255, 255, 255, 140);
}

QStatusBar::item {
    border: 0;
}

QStatusBar QLabel {
    color: rgba(255, 255, 255, 140);
    padding: 0 4px;
}

QPushButton#TogglableStatusBarButton,
QPushButton#RendererStatusBarButton,
QPushButton#GPUStatusBarButton,
QPushButton#DockingStatusBarButton {
    min-height: 20px;
    max-height: 20px;
    padding: 0 4px;
    margin: 0;
    border: 0;
    border-radius: 10px;
    background-color: #12131a;
    color: rgba(255, 255, 255, 158);
    font-size: 8pt;
}

/* One color per chip category; the :!checked rule below greys out chips that are off. */

/* GPU accuracy */
QPushButton#GPUStatusBarButton[chip="gpu"] {
    background-color: rgba(245, 185, 66, 0.14);
    color: #f5b942;
}

/* dock mode */
QPushButton#DockingStatusBarButton[chip="dock"] {
    background-color: rgba(96, 165, 250, 0.14);
    color: #60a5fa;
}

/* scaling filter */
QPushButton#TogglableStatusBarButton[chip="filter"] {
    background-color: rgba(167, 139, 250, 0.14);
    color: #a78bfa;
}

/* anti-aliasing */
QPushButton#TogglableStatusBarButton[chip="aa"] {
    background-color: rgba(34, 211, 238, 0.14);
    color: #22d3ee;
}

/* post effects */
QPushButton#TogglableStatusBarButton[chip="fx"] {
    background-color: rgba(163, 217, 94, 0.14);
    color: #a3d95e;
}

/* frame generation */
QPushButton#TogglableStatusBarButton[chip="fg"] {
    background-color: rgba(255, 138, 76, 0.14);
    color: #ff8a4c;
}

/* volume */
QPushButton#TogglableStatusBarButton[chip="volume"] {
    background-color: rgba(232, 121, 249, 0.14);
    color: #e879f9;
}

QPushButton#TogglableStatusBarButton:!checked {
    background-color: transparent;
    color: rgba(255, 255, 255, 92);
}

QPushButton#RendererStatusBarButton {
    background-color: rgba(255, 107, 149, 41);
    color: #ff6b95;
}

QPushButton#TogglableStatusBarButton:hover,
QPushButton#RendererStatusBarButton:hover,
QPushButton#GPUStatusBarButton:hover,
QPushButton#DockingStatusBarButton:hover {
    background-color: rgba(255, 255, 255, 20);
    color: #ffffff;
}

QPushButton#RefreshButton {
    min-height: 20px;
    max-height: 20px;
    padding: 0 4px;
    border: 0;
    background-color: transparent;
    color: rgba(255, 255, 255, 115);
}

QPushButton#RefreshButton:hover {
    color: #ffffff;
}

QPushButton#buttonRefreshDevices {
    min-width: 30px;
    max-width: 30px;
    padding: 0;
}

QPushButton#button_reset_defaults {
    padding: 0 12px;
}

