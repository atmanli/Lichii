QPushButton[ghost="true"] { font: 600 13px "Lexend"; background: transparent; border: none; border-radius: 18px;
                            min-height: 36px; max-height: 36px; padding: 0 18px; color: #ffffff; }
QPushButton[ghost="true"]:hover { background: #14ffffff; }
QPushButton[outline="true"] { font: 600 13px "Lexend"; background: #1fffffff; border: 1px solid #2effffff;
                              border-radius: 18px; min-height: 36px; max-height: 36px; padding: 0 18px; color: #ffffff; }
QPushButton[outline="true"]:hover { background: #2effffff; }
QPushButton[outline="true"]:disabled { color: #73ffffff; }
QFrame[bindingRow="true"] { background: #0fffffff; border: 1px solid #14ffffff; border-radius: 12px; }
QPushButton[chip="true"] { font: 600 12px "Lexend"; background: #1fffffff; border: none; border-radius: 8px;
                           min-height: 24px; max-height: 24px; padding: 0 8px; color: #ffffff; }
QPushButton[chip="true"]:hover { background: #2effffff; }
QLineEdit#tas_path_edit { min-height: 38px; max-height: 38px; border-radius: 12px; padding: 0 14px;
