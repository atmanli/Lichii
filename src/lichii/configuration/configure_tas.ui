  <property name="styleSheet"><string notr="true">QLabel[row="true"] { font: 500 14px "Lexend"; color: #ffffff; }
QLabel[rowStrong="true"] { font: 600 14px "Lexend"; color: #ffffff; }
QLabel[sliderLabel="true"] { font: 400 13px "Lexend"; color: #9effffff; }
