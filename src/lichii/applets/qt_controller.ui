 <widget class="QDialog" name="QtControllerSelectorDialog">
  <property name="windowTitle">
   <string>Controller Applet</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QLabel[caption="true"] { color: rgba(255, 255, 255, 214); font-weight: 600; }
QLabel[chip="true"] { background-color: rgba(255, 255, 255, 20); border-radius: 10px; padding: 3px 9px; font-size: 11px; font-weight: 600; }
QLabel#numberSupportedLabel { background-color: rgba(143, 181, 255, 46); color: #8fb5ff; border-radius: 10px; padding: 3px 12px; font-size: 11px; font-weight: 600; }
QFrame#controllersCard { background-color: rgba(255, 255, 255, 13); border: 1px solid rgba(255, 255, 255, 20); border-radius: 18px; }
QFrame#controllersDivider { background-color: rgba(255, 255, 255, 18); border: 0; }
QLabel#labelControllers { font-weight: 600; }
QLabel#labelConnected { color: rgba(255, 255, 255, 158); font-weight: 600; }
QLabel#labelError { color: #ffd37a; background-color: rgba(255, 211, 122, 20); border: 1px solid rgba(255, 211, 122, 64); border-radius: 12px; padding: 9px 12px; }
QLabel[playerNumber="true"] { font-weight: 600; }
QGroupBox[player="true"], QGroupBox[player="true"]:checked, QGroupBox[player="true"]:unchecked { border: 0; margin: 0; padding: 0; min-height: 0; background: transparent; }
QCheckBox[playerToggle="true"] { spacing: 0; }
QCheckBox[playerToggle="true"]::indicator { width: 18px; height: 18px; border: 0; border-radius: 0; background: transparent; }
QCheckBox[playerToggle="true"]::indicator:unchecked { image: url(:/lichii/icons/check_off.png); }
QCheckBox[playerToggle="true"]::indicator:unchecked:hover { image: url(:/lichii/icons/check_off_hover.png); }
QCheckBox[playerToggle="true"]::indicator:checked { image: url(:/lichii/icons/check_on.png); }
QCheckBox[playerToggle="true"]::indicator:disabled { image: url(:/lichii/icons/check_off_disabled.png); }
QGroupBox[player="true"]::title { width: 0; height: 0; padding: 0; margin: 0; }
QGroupBox[player="true"]::indicator { width: 0; height: 0; }
QLabel[explain="true"] { color: rgba(255, 255, 255, 158); }
QCheckBox[led="true"] { spacing: 0; }
QCheckBox[led="true"]::indicator { width: 6px; height: 6px; margin: 0; border-radius: 3px; border: 0; background-color: rgba(255, 255, 255, 46); image: none; }
QCheckBox[led="true"]::indicator:checked { background-color: #7ee2a8; image: none; }
QFrame#consoleModeSegment { background-color: rgba(255, 255, 255, 20); border-radius: 20px; }
QRadioButton[segment="true"] { border-radius: 16px; padding: 6px 16px; font-weight: 600; color: rgba(255, 255, 255, 214); }
QRadioButton[segment="true"]::indicator { width: 0; height: 0; }
QRadioButton[segment="true"]:checked { background-color: #ff6b95; color: #2a0a14; }
QRadioButton[segment="true"]:checked:disabled { background-color: rgba(255, 107, 149, 90); color: rgba(255, 255, 255, 214); }
QGroupBox[toggle="true"] { border: 0; margin: 0; padding: 0 0 0 28px; background: transparent; }
QGroupBox[toggle="true"]::title { subcontrol-origin: padding; subcontrol-position: left center; left: 0px; padding: 0; }</string>
