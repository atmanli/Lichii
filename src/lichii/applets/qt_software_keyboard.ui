QWidget#mainOSK QTextEdit { background: rgba(255, 255, 255, 10); border: 1px solid rgba(255, 255, 255, 26); border-radius: 10px; color: #ffffff; padding: 6px 8px; selection-background-color: #ff6b95; selection-color: #2a0a14; }
QWidget#mainOSK QPushButton { background: #262731; color: #ffffff; border: 2px solid transparent; border-radius: 8px; padding: 0px; }
QWidget#mainOSK QPushButton:hover, QWidget#mainOSK QPushButton:focus { background: #33343f; border: 2px solid #ff6b95; outline: none; }
QWidget#mainOSK QPushButton:pressed { background: #3d3e4b; }
QWidget#mainOSK QPushButton:disabled { background: rgba(255, 255, 255, 8); color: rgba(255, 255, 255, 64); border: 2px solid transparent; }
QWidget#mainOSK QPushButton#button_return, QWidget#mainOSK QPushButton#button_return_shift { color: rgba(255, 255, 255, 158); }
QWidget#mainOSK QPushButton#button_shift_shift[locked="true"] { border: 2px solid #ff6b95; }
QWidget#mainOSK QPushButton#button_ok, QWidget#mainOSK QPushButton#button_ok_shift, QWidget#mainOSK QPushButton#button_ok_num { background: #ff6b95; color: #2a0a14; }
