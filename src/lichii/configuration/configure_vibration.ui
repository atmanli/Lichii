   <item>
    <widget class="QFrame" name="vibrationSettingsGroup">
     <property name="card" stdset="0"><bool>true</bool></property>
     <layout class="QVBoxLayout" name="settingsLayout">
      <property name="spacing"><number>10</number></property>
      <property name="leftMargin"><number>16</number></property>
      <property name="topMargin"><number>16</number></property>
      <property name="rightMargin"><number>16</number></property>
      <property name="bottomMargin"><number>16</number></property>
      <item>
       <widget class="QCheckBox" name="checkBoxAccurateVibration">
        <property name="text"><string>Enable Accurate Vibration</string></property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="checkBoxDualSenseHaptics">
        <property name="text"><string>Enable DualSense HD Haptics</string></property>
        <property name="toolTip"><string>Play HD Rumble through the DualSense haptic actuators, left and right apart. Requires a USB connection and a single wired DualSense; otherwise standard rumble is used.</string></property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="checkBoxFrequencyRumble">
        <property name="text"><string>Frequency-aware rumble</string></property>
        <property name="toolTip"><string>On controllers with two rumble motors, send each part of the HD Rumble to the motor that matches its frequency: low tones to the heavy motor, high tones to the light one. When off, each band drives its own motor as before.</string></property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="triggerRumbleLayout">
        <property name="spacing"><number>12</number></property>
        <property name="leftMargin"><number>0</number></property>
        <property name="topMargin"><number>0</number></property>
        <property name="rightMargin"><number>0</number></property>
        <property name="bottomMargin"><number>0</number></property>
        <item>
         <widget class="QCheckBox" name="checkBoxTriggerRumble">
          <property name="text"><string>Trigger rumble</string></property>
          <property name="toolTip"><string>On controllers with motors in their triggers, also play the light part of the HD Rumble on them: the left side on the left trigger, the right side on the right one. 20% is a good start.</string></property>
         </widget>
        </item>
        <item>
         <spacer name="spacer9">
          <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
          <property name="sizeType"><enum>QSizePolicy::Policy::Expanding</enum></property>
          <property name="sizeHint"><size><width>0</width><height>0</height></size></property>
         </spacer>
        </item>
        <item>
         <widget class="QSlider" name="sliderTriggerRumble">
          <property name="minimum"><number>1</number></property>
          <property name="maximum"><number>100</number></property>
          <property name="value"><number>20</number></property>
          <property name="singleStep"><number>5</number></property>
          <property name="pageStep"><number>5</number></property>
          <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
          <property name="minimumSize"><size><width>150</width><height>18</height></size></property>
          <property name="maximumSize"><size><width>150</width><height>18</height></size></property>
          <property name="toolTip"><string>On controllers with motors in their triggers, also play the light part of the HD Rumble on them: the left side on the left trigger, the right side on the right one. 20% is a good start.</string></property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="labelTriggerRumble">
          <property name="text"><string notr="true">20%</string></property>
          <property name="value" stdset="0"><bool>true</bool></property>
          <property name="minimumSize"><size><width>44</width><height>0</height></size></property>
          <property name="maximumSize"><size><width>44</width><height>16777215</height></size></property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QLabel" name="labelTriggerHint">
        <property name="text"><string>Trigger intensity: 1–100% in steps of 5. Available when Trigger rumble is on.</string></property>
        <property name="hint" stdset="0"><bool>true</bool></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBoxVibration">
     <property name="standardButtons"><set>QDialogButtonBox::StandardButton::Cancel|QDialogButtonBox::StandardButton::Ok</set></property>
    </widget>
